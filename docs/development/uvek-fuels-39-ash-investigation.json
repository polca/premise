{
  "status": "primary-source investigation; not an implemented mapping or fuel qualification",
  "evidence_sha256": "016d0e99e2c6b79a03253a963a926a3a86062ad0acf40eeabac9e39f32d255b3",
  "source": "Installed licensed ecoinvent 3.9 cut-off; private extraction retained outside repository",
  "findings": [
    "51 distinct receiving inventories contain only a negative production reference and have zero source price. They are allocation-empty receiving services, not positive-reference recycled stocks.",
    "16 distinct receiving inventories model nonempty disposal burdens. All original freight rows must survive.",
    "The current three-fate RoW candidate does not preserve the whole source market. Its renormalized disposal shares must not replace the full source fate split."
  ],
  "implementation_decision": {
    "empty_receivers": "Retain each identity, source inventory hash and signed quantity in a scoped audit. An explicitly warned omission of these independently verified empty inventories can preserve the source LCI without inventing a native treatment or changing the positive-reference zero-stock schema. No recovery credit is created.",
    "nonempty_receivers": "Bind complete reviewed disposal processes at their original quantities; keep landfill and incineration technologies distinct. Swiss fly-ash extraction remains a separately warned technology proxy if no matching native process exists.",
    "freight": "Preserve every source row, signed quantity, uncertainty and unit using reviewed native transport correspondences; do not renormalize disposal shares.",
    "signs": "The source market and receivers have -1 kg references. A +1 kg target treatment service needs a reviewed sign conversion; do not derive it from the word treatment alone.",
    "qualification": "Not yet implemented. Verify fresh/cached conversion, complete recipe closure and finite native LCI before accepting this dependency for activated-carbon production."
  },
