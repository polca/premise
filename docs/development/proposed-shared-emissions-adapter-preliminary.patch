+@pytest.mark.parametrize("amount", [-2.0, 2.0])
+@pytest.mark.parametrize("uncertainty", [2, 3])
+def test_operating_region_copy_preserves_signed_purchase_and_upstream_inventory(
+    case, amount, uncertainty
+):
+    s, source, before, *_ = case(amount=amount, uncertainty=uncertainty)
+    raw = payload(source)
+    update(s)
+    data = payload(s["_inventory_store"])
+    assert payload(source) == raw
+    c = next(a for a in data if module._EMISSION_SOURCE_MARKER in a)
+    assert c["location"] == "NEU"
+    assert next(e for e in c["exchanges"] if e["name"] == "Nitrogen oxides")[
+        "amount"
+    ] == pytest.approx(0.2)
+    assert next(e for e in c["exchanges"] if e["type"] == "technosphere") == next(
+        e for e in raw[1]["exchanges"] if e["type"] == "technosphere"
+    )
+    assert next(e for e in c["exchanges"] if e["name"] == "Ammonia")["amount"] == 1.0
+    assert (
+        next(e for e in c["exchanges"] if e["name"] == "Carbon dioxide, fossil")[
+            "amount"
+        ]
+        == 8.0
+    )
+    edge = data[0]["exchanges"][1]
+    old = raw[0]["exchanges"][1]
+    assert {
+        k: v for k, v in edge.items() if k not in ("name", "location", "input")
+    } == {k: v for k, v in old.items() if k not in ("name", "location", "input")}
