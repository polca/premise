+def test_conflicting_review_does_not_commit(case):
+    s, source, before, review, mapping, path = case()
+    review["bindings"].append({**review["bindings"][0], "sector": "Industry"})
+    (path.parent / "review.json").write_text(json.dumps(review))
+    raw = payload(source)
+    with pytest.raises(ValueError, match="Conflicting"):
+        update(s)
+    assert (
+        s["_inventory_store"] is source
+        and payload(source) == raw
+        and "emissions diagnostics" not in s
+    )
