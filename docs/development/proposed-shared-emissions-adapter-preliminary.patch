+def test_uncertain_handover_is_preserved(case):
+    s, source, *_ = case(handover=True)
+    with source.transaction("uncertain handover") as tx:
+        handover, _, edge_ids = next(
+            row
+            for row in source._iter_storage_activities()
+            if row[1]["code"] == "handover"
+        )
+        eid = edge_ids[-1]
+        tx.patch_exchange(
+            eid, {"uncertainty type": 2, "loc": 0.0, "scale": 0.1}, activity_id=handover
+        )
+    update(s)
+    assert (
+        s["emissions diagnostics"]["copies"] == 0
+        and s["emissions diagnostics"]["nonemitting_positions"] == 1
+    )
