+def test_shared_factor_failure_does_not_commit_prepared_fork(case, monkeypatch):
+    s, source, *_ = case()
+    raw = payload(source)
+
+    def fail(self, store):
+        raise RuntimeError("deliberate failure")
+
+    monkeypatch.setattr(module.Emissions, "update_emissions_in_store", fail)
+    with pytest.raises(RuntimeError, match="deliberate"):
+        update(s)
+    assert (
+        s["_inventory_store"] is source and payload(source) == raw and "cache" not in s
+    )
