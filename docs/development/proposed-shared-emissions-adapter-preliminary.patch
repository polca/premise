+_EMISSION_SOURCE_MARKER = "premise emissions source"
+
+
+def _emission_source_definitions(family):
+    return {
+        role: definition.get("emission_sources", definition)
+        for role, definition in get_mapping(
+            filepath=GAINS_MAPPING, var=f"{family}_aliases"
+        ).items()
+    }
+
+
+def _prepare_emission_sources(store, updater):
+    """Bind declared source classes to sectors without changing physical inputs."""
+    import hashlib
+    import json
+
+    fields = ("name", "reference product", "unit")
+
+    def signature(record):
+        return tuple(
+            record.get(
+                field, record.get("product") if field == "reference product" else None
+            )
+            for field in fields
+        )
+
+    def region(location):
+        return (
+            location
+            if location in updater.gains_IAM.region
+            else updater.ecoinvent_to_iam_loc[location]
+        )
+
+    resources = defaultdict(set)
+    for role, definition in updater.gains_definitions.items():
+        for resource in definition.get("context_resources", ()):
+            resources[resource].add(role)
+    scopes = {}
+    for resource, roles in resources.items():
+        review = json.loads((DATA_DIR / resource).read_text())
+        for row in review["bindings"]:
+            if row["sector"] not in roles:
+                continue
+            scope = signature(row["caller"]), signature(row["supplier"])
+            if scope in scopes and scopes[scope] != row["sector"]:
+                raise ValueError("Conflicting emissions source-class assignments.")
+            scopes[scope] = row["sector"]
+    rows = {
+        aid: (activity, tuple(edges))
+        for aid, activity, edges in store._iter_storage_activities()
+    }
+    identities = defaultdict(list)
+    aliases = {}
+    for aid, (activity, _) in rows.items():
+        identities[signature(activity), activity["location"]].append(aid)
+        marker = activity.get(_EMISSION_SOURCE_MARKER)
+        if marker:
+            if marker["sector"] not in updater.gains_definitions:
+                raise ValueError("Existing emissions source has an undeclared sector.")
+            aliases[activity["name"]] = marker["sector"]
+
+    def supplier(edge):
+        matches = identities[signature(edge), edge["location"]]
+        if len(matches) != 1:
+            raise ValueError("Missing or ambiguous emissions source endpoint.")
+        return matches[0]
+
+    pending, retained, reused = [], 0, 0
+    for aid, (caller, edge_ids) in rows.items():
+        for eid in edge_ids:
+            edge = store._storage_exchange(eid)
+            role = (
+                scopes.get((signature(caller), signature(edge)))
+                if edge["type"] == "technosphere" and edge["amount"]
+                else None
+            )
+            if role is None:
+                continue
+            sid = supplier(edge)
+            visited = set()
+            while True:
+                source, source_ids = rows[sid]
+                edges = [store._storage_exchange(i) for i in source_ids]
+                if any(e["type"] == "biosphere" and e["amount"] for e in edges):
+                    break
+                prod = [e for e in edges if e["type"] == "production"]
+                tech = [e for e in edges if e["type"] == "technosphere" and e["amount"]]
+                if not (
+                    len(prod) == len(tech) == 1
+                    and prod[0]["amount"] == tech[0]["amount"] == 1
+                    and signature(tech[0]) == signature(source)
+                    and tech[0].get("uncertainty type", 0) in (0, 1)
+                    and not tech[0].get("formula")
+                ):
+                    sid = None
+                    break
+                if sid in visited or len(visited) >= 2:
+                    raise ValueError("Emissions source handover is cyclic or too deep.")
+                visited.add(sid)
+                sid = supplier(tech[0])
+            if sid is None:
+                retained += 1
+                continue
+            source, source_ids = rows[sid]
+            location = (
+                caller["location"]
+                if caller["location"] in updater.gains_IAM.region
+                else source["location"]
+            )
+            if updater.rev_gains_map.get(source["name"]) == role and region(
+                location
+            ) == region(source["location"]):
+                reused += 1
+                continue
+            production = [
+                store._storage_exchange(i)
+                for i in source_ids
+                if store._storage_exchange(i)["type"] == "production"
+            ]
+            if (
+                len(production) != 1
+                or production[0]["amount"] != 1
+                or signature(production[0]) != signature(source)
+            ):
+                raise ValueError(
+                    "Contextual emissions requires an exact +1 source reference."
+                )
+            if source.get("log parameters", {}).get("GAINS sector"):
+                raise ValueError(
+                    "A new emissions context needs a source before its GAINS update; rebuild in the normal sector order."
+                )
+            pending.append((aid, eid, sid, role, location))
+    copies, added, relinked = {}, {}, {}
+    metadata_fields = (
+        "name",
+        "reference product",
+        "location",
+        "unit",
+        "database",
+        "code",
+    )
+    with store.transaction("prepare:emissions-source-context") as tx:
+        for aid, eid, sid, role, location in pending:
+            token = sid, role, location
+            source, source_ids = rows[sid]
+            if token not in copies:
+                source_key = source["database"], source["code"]
+                digest = hashlib.sha256(
+                    json.dumps([source_key, role, location]).encode()
+                ).hexdigest()[:32]
+                updates = {
+                    "name": f"{source['name']} [role {role}, source {source['location']}, at {location}]",
+                    "location": location,
+                    "code": "premise-emissions-" + digest,
+                    _EMISSION_SOURCE_MARKER: {
+                        "source_key": list(source_key),
+                        "sector": role,
+                        "location": location,
+                    },
+                }
+                target = {
+                    field: source.get(field) for field in metadata_fields
+                } | updates
+                target_key = source["database"], updates["code"]
+                endpoints = {}
+                for index, source_eid in enumerate(source_ids):
+                    e = store._storage_exchange(source_eid)
+                    change = {"output": target_key} if "output" in e else {}
+                    if e["type"] == "production":
+                        change.update(
+                            name=updates["name"], location=location, input=target_key
+                        )
+                    if change:
+                        endpoints[index] = change
+                tx.clone_activity(sid, updates, endpoints)
+                copies[token] = target
+                added[target_key] = target
+                aliases[target["name"]] = role
+            target = copies[token]
+            change = {
+                "name": target["name"],
+                "location": target["location"],
+                "input": (target["database"], target["code"]),
+            }
+            tx.patch_exchange(eid, change, activity_id=aid)
+            relinked[aid] = {
+                field: rows[aid][0].get(field) for field in metadata_fields
+            }
+    return {
+        "aliases": aliases,
+        "added": added,
+        "relinked": relinked,
+        "copies": len(added),
+        "relinked_exchanges": len(pending),
+        "reused_positions": reused,
+        "nonemitting_positions": retained,
+    }
+
+
+def _update_contextual_emissions(
+    scenario, version, system_model, gains_scenario, family, biosphere_version
+):
+    """Thin source-topology adapter; all GAINS arithmetic uses Emissions."""
+    from ..transport.vehicle_energy_use import refresh_vehicle_energy_emissions
+    from ..inventory.inventory_store import create_inventory_store
+    from ..core.transformation import (
+        _VALIDATION_ADDED_TARGETS_KEY,
+        _VALIDATION_RELINKED_TARGETS_KEY,
+    )
+
+    if (str(version), system_model, biosphere_version) != (
+        "2026",
+        "cutoff",
+        "3.10",
+    ) or gains_scenario not in {"CLE", "MFR"}:
+        raise ValueError(
+            "UVEK emissions requires 2026 cut-off with biosphere 3.10 and CLE/MFR."
+        )
+    if scenario["iam data"].gains_data_IAM is None:
+        return refresh_vehicle_energy_emissions(scenario)
+    original = scenario.get("_inventory_store")
+    source = (
+        original
+        if original is not None
+        else create_inventory_store(get_scenario_inventory(scenario), backend="compact")
+    )
+    working = source.fork("emissions-source-context")
+    updater = Emissions.from_inventory_store(
+        store=working,
+        iam_data=scenario["iam data"],
+        model=scenario["model"],
+        pathway=scenario["pathway"],
+        year=scenario["year"],
+        version=version,
+        system_model=system_model,
+        gains_scenario=gains_scenario,
+        family=family,
+    )
+    prepared = _prepare_emission_sources(working, updater)
+    updater.rev_gains_map.update(prepared["aliases"])
+    if isinstance(working, CompactInventoryStore):
+        affected = updater.update_emissions_in_store(working)
+    else:
+        working = create_inventory_store(
+            updater.iter_updated_legacy_inventory(working), backend=working.backend_name
+        )
+        affected = set()
+    # Commit the owned fork only after preparation and the shared update succeed.
+    if original is None:
+        replace_scenario_inventory(scenario, working.materialize(), take_ownership=True)
+    else:
+        scenario["_inventory_store"] = working
+    scenario.pop("index", None)
+    scenario["cache"] = {
+        _VALIDATION_ADDED_TARGETS_KEY: prepared["added"],
+        _VALIDATION_RELINKED_TARGETS_KEY: prepared["relinked"],
+    }
+    changed = {
+        (a["name"], a["reference product"], a["location"])
+        for a in (*prepared["added"].values(), *prepared["relinked"].values())
+    }
+    scenario.setdefault("_validation_direct_targets", {})["emissions"] = {
+        "activity_keys": sorted(set(affected) | changed, key=repr)
+    }
+    scenario["emissions diagnostics"] = {
+        k: v for k, v in prepared.items() if k not in {"aliases", "added", "relinked"}
+    }
+    limitations = list(
+        dict.fromkeys(
+            message
+            for definition in updater.gains_definitions.values()
+            for message in definition.get("limitations", ())
+        )
+    )
+    scenario.setdefault(
+        "background context",
+        {
+            "family": family,
+            "version": str(version),
+            "system_model": system_model,
+            "biosphere_family": "ecoinvent",
+            "biosphere_version": biosphere_version,
+        },
+    )
+    scenario.setdefault("native sector limitations", {})["emissions"] = limitations
+    scenario.setdefault("native sector audits", {})["emissions"] = {
+        "method": "shared Premise GAINS updater with declared source contexts",
+        "full_sector_mapping_complete": False,
+        **scenario["emissions diagnostics"],
+    }
+    if limitations:
+        import warnings
+
+        warnings.warn(" ".join(limitations), UserWarning, stacklevel=2)
+    for activity in (*prepared["added"].values(), *prepared["relinked"].values()):
+        updater.write_log(activity, status="updated")
+    return refresh_vehicle_energy_emissions(scenario)
+
