+def test_wrong_reference_does_not_commit(case):
+    s, source, *_ = case()
+    raw = payload(source)
+    with source.transaction("bad reference") as tx:
+        aid, _, edge_ids = next(
+            row
+            for row in source._iter_storage_activities()
+            if row[1]["code"] == "burner"
+        )
+        eid = edge_ids[0]
+        tx.patch_exchange(eid, {"amount": -1.0}, activity_id=aid)
+    raw = payload(source)
+    with pytest.raises(ValueError, match="exact \\+1"):
+        update(s)
+    assert s["_inventory_store"] is source and payload(source) == raw
