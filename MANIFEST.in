include CHANGELOG.md
include CITATION.cff
include LICENSE
include README.md
include docs/Makefile docs/make.bat
recursive-include docs *.csv *.inc *.md *.png *.rst *.svg *.py *.css *.html *.ico *.json *.yaml *.txt
include docs/_tools/check_documentation*.py
include docs/_tools/generate_documentation_reference.py
include docs/_tools/generate_methodology_diagrams.py
prune docs/_build
prune docs/.ipynb_checkpoints
prune docs/_templates/.ipynb_checkpoints
prune premise/data/iam_output_files
global-exclude .DS_Store *.py[cod]

# Keep private licensed outputs out of source distributions too.
prune results
prune scripts
exclude tests/data/lcia_regression_scores.yaml
exclude docs/development/lcia-regression-reference-review.md
exclude docs/examples/pv-comparison-summary.json
exclude docs/examples/pv-comparison-metadata.json
exclude premise/data/solar/pv_2026_gwp100_reference.csv
exclude premise/data/metals/ecoinvent_factors.csv
